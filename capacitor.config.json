{
  "appId": "com.cutefantasy.rpg",
  "appName": "Cute Fantasy RPG",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "backgroundColor": "#0b0e14"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0b0e14",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#0b0e14"
    },
    "ScreenOrientation": {
      "orientation": "landscape"
    }
  }
}
